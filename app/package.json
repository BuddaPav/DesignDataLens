{
    "name":  "chronos-ai-chronicles",
    "private":  true,
    "version":  "1.0.0",
    "description":  "Chronos: AI Chronicles — нарративная RPG с процедурным миром (десктоп Electron и веб-сборка).",
    "type":  "module",
    "main":  "electron/main.cjs",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "chronosDownloadUrl":  "",
    "chronosReleaseNotesRu":  "",
    "scripts":  {
                    "prebuild":  "node scripts/sync-version.mjs \u0026\u0026 node scripts/generate-chronos-atlas.mjs \u0026\u0026 node scripts/vendor-kenney-icons.mjs",
                    "vendor:kenney-icons":  "node scripts/vendor-kenney-icons.mjs",
                    "generate:atlas":  "node scripts/generate-chronos-atlas.mjs",
                    "generate:placeholder:3d":  "node scripts/generate-placeholder-3d.mjs",
                    "generate:mass:3d":  "node scripts/generate-aaa-mass-model-pack.mjs",
                    "generate:ai-art":  "node scripts/generate-ai-art.mjs",
                    "dev":  "vite",
                    "play":  "vite --open --host 127.0.0.1",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "lint":  "eslint .",
                    "test":  "vitest run",
                    "test:e2e":  "playwright test",
                    "test:e2e:smoke":  "playwright test e2e/intro-smoke.spec.ts",
                    "test:e2e:map":  "playwright test e2e/map-hotkeys.spec.ts",
                    "test:e2e:scene":  "playwright test e2e/first-scene.spec.ts",
                    "test:e2e:panels":  "playwright test e2e/panel-hotkeys.spec.ts",
                    "test:e2e:install":  "playwright install chromium",
                    "test:watch":  "vitest",
                    "test:coverage":  "vitest run --coverage",
                    "deps:circular":  "madge --circular --extensions ts,tsx ./src",
                    "deps:export":  "node scripts/export-deps-json.mjs",
                    "audit:secrets":  "node scripts/audit-no-secrets.mjs",
                    "diagnose":  "node scripts/diagnose.mjs",
                    "check:assets":  "node scripts/check-public-asset-refs.mjs",
                    "i18n:export":  "node scripts/i18n-export-keys.mjs",
                    "orchestrate:gate":  "npm run lint \u0026\u0026 npm run test \u0026\u0026 npm run deps:circular",
                    "typecheck:tests":  "tsc -p tsconfig.vitest.json --noEmit",
                    "qa":  "npm run orchestrate:gate \u0026\u0026 npm run typecheck:tests \u0026\u0026 npm run build \u0026\u0026 npm run test:e2e",
                    "ci":  "npm run orchestrate:gate \u0026\u0026 npm run typecheck:tests",
                    "mvp:gate":  "npm run orchestrate:gate",
                    "mvp:progress":  "node scripts/mvp-progress.mjs",
                    "orchestrate:archaeology":  "node scripts/archaeology-reminder.mjs",
                    "orchestrate:assets":  "node scripts/assets-inventory.mjs",
                    "aaa:vertical-slice:gate":  "node scripts/aaa-vertical-slice-gate.mjs",
                    "aaa:asset-factory:gate":  "node scripts/aaa-asset-factory-gate.mjs",
                    "aaa:graphics:gate":  "node scripts/aaa-graphics-gate.mjs",
                    "aaa:asset:report":  "node scripts/aaa-asset-report.mjs",
                    "aaa:full-production:progress":  "node scripts/aaa-full-production-progress.mjs",
                    "aaa:release:gate":  "node scripts/aaa-release-gate.mjs",
                    "preview":  "vite preview",
                    "desktop":  "cross-env CHRONOS_DESKTOP_DEV=1 concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 \u0026\u0026 electron .\"",
                    "desktop:pack":  "npm run build \u0026\u0026 electron-packager . ChronosChronicles --platform=win32 --arch=x64 --asar --prune=true --out=../desktop-dist --overwrite",
                    "desktop:installer":  "npm run build \u0026\u0026 electron-builder --win nsis --x64",
                    "ai:index":  "node ../ai_support/run.ts index",
                    "ai:search":  "node ../ai_support/run.ts search",
                    "ai:analyze":  "node ../ai_support/run.ts analyze",
                    "ai:help":  "node ../ai_support/run.ts help",
                    "obsidian:sync":  "node scripts/obsidian-sync.mjs",
                    "obsidian:pull":  "node scripts/obsidian-sync.mjs pull",
                    "obsidian:push":  "node scripts/obsidian-sync.mjs push",
                    "obsidian:status":  "node scripts/obsidian-sync.mjs status",
                    "obsidian:daemon":  "node scripts/obsidian-auto-sync.cjs",
                    "secondbrain:init":  "node ../ai_support/secondbrain/index.ts",
                    "secondbrain:cli":  "node ../ai_support/secondbrain/cli.ts",
                    "secondbrain:game":  "node ../ai_support/secondbrain/gameFactory.ts",
                    "secondbrain:autonomous":  "node ../ai_support/secondbrain/autonomous.ts",
                    "secondbrain:snapshot":  "node ../ai_support/secondbrain/communication/snapshot.ts",
                    "secondbrain:security":  "node ../ai_support/secondbrain/security/scanner.ts"
                },
    "build":  {
                  "appId":  "com.chronos.ai.chronicles",
                  "productName":  "Chronos AI Chronicles",
                  "directories":  {
                                      "output":  "../desktop-installer"
                                  },
                  "files":  [
                                "dist/**/*",
                                "electron/**/*",
                                "package.json"
                            ],
                  "asar":  true,
                  "win":  {
                              "signAndEditExecutable":  false,
                              "target":  [
                                             "@{target=nsis; arch=System.Object[]}"
                                         ],
                              "artifactName":  "${productName}-Setup-${version}.${ext}"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowElevation":  true,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "Chronos AI Chronicles"
                           }
              },
    "dependencies":  {
                         "@fontsource/exo-2":  "^5.2.8",
                         "@fontsource/inter":  "^5.2.8",
                         "@hookform/resolvers":  "^5.2.2",
                         "@mlc-ai/web-llm":  "^0.2.79",
                         "@radix-ui/react-accordion":  "^1.2.12",
                         "@radix-ui/react-alert-dialog":  "^1.1.15",
                         "@radix-ui/react-aspect-ratio":  "^1.1.8",
                         "@radix-ui/react-avatar":  "^1.1.11",
                         "@radix-ui/react-checkbox":  "^1.3.3",
                         "@radix-ui/react-collapsible":  "^1.1.12",
                         "@radix-ui/react-context-menu":  "^2.2.16",
                         "@radix-ui/react-dialog":  "^1.1.15",
                         "@radix-ui/react-dropdown-menu":  "^2.1.16",
                         "@radix-ui/react-hover-card":  "^1.1.15",
                         "@radix-ui/react-label":  "^2.1.8",
                         "@radix-ui/react-menubar":  "^1.1.16",
                         "@radix-ui/react-navigation-menu":  "^1.2.14",
                         "@radix-ui/react-popover":  "^1.1.15",
                         "@radix-ui/react-progress":  "^1.1.8",
                         "@radix-ui/react-radio-group":  "^1.3.8",
                         "@radix-ui/react-scroll-area":  "^1.2.10",
                         "@radix-ui/react-select":  "^2.2.6",
                         "@radix-ui/react-separator":  "^1.1.8",
                         "@radix-ui/react-slider":  "^1.3.6",
                         "@radix-ui/react-slot":  "^1.2.4",
                         "@radix-ui/react-switch":  "^1.2.6",
                         "@radix-ui/react-tabs":  "^1.1.13",
                         "@radix-ui/react-toggle":  "^1.1.10",
                         "@radix-ui/react-toggle-group":  "^1.1.11",
                         "@radix-ui/react-tooltip":  "^1.2.8",
                         "@react-three/drei":  "^10.7.7",
                         "@react-three/fiber":  "^9.6.0",
                         "@react-three/postprocessing":  "^3.0.4",
                         "@types/three":  "^0.184.0",
                         "class-variance-authority":  "^0.7.1",
                         "clsx":  "^2.1.1",
                         "cmdk":  "^1.1.1",
                         "date-fns":  "^4.1.0",
                         "embla-carousel-react":  "^8.6.0",
                         "input-otp":  "^1.4.2",
                         "lucide-react":  "^0.562.0",
                         "next-themes":  "^0.4.6",
                         "postprocessing":  "^6.39.1",
                         "react":  "^19.2.0",
                         "react-day-picker":  "^9.13.0",
                         "react-dom":  "^19.2.0",
                         "react-hook-form":  "^7.70.0",
                         "react-resizable-panels":  "^4.2.2",
                         "recharts":  "^2.15.4",
                         "sonner":  "^2.0.7",
                         "tailwind-merge":  "^3.4.0",
                         "three":  "^0.184.0",
                         "vaul":  "^1.1.2",
                         "zod":  "^4.3.5"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.39.1",
                            "@playwright/test":  "^1.59.1",
                            "@types/node":  "^24.10.1",
                            "@types/react":  "^19.2.5",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^5.1.1",
                            "@vitest/coverage-v8":  "^4.1.5",
                            "autoprefixer":  "^10.4.23",
                            "concurrently":  "^9.2.1",
                            "cross-env":  "^10.1.0",
                            "electron":  "^35.7.5",
                            "electron-builder":  "^26.8.1",
                            "electron-packager":  "^17.1.2",
                            "eslint":  "^9.39.1",
                            "eslint-plugin-react-hooks":  "^7.0.1",
                            "eslint-plugin-react-refresh":  "^0.4.24",
                            "globals":  "^16.5.0",
                            "jsdom":  "^29.1.1",
                            "kimi-plugin-inspect-react":  "^1.0.3",
                            "madge":  "^8.0.0",
                            "playwright":  "^1.59.1",
                            "postcss":  "^8.5.6",
                            "sharp":  "^0.34.5",
                            "tailwindcss":  "^3.4.19",
                            "tailwindcss-animate":  "^1.0.7",
                            "tw-animate-css":  "^1.4.0",
                            "typescript":  "~5.9.3",
                            "typescript-eslint":  "^8.46.4",
                            "vite":  "^7.2.4",
                            "vitest":  "^4.1.5",
                            "wait-on":  "^9.0.3"
                        }
}
