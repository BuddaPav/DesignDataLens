{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChronosProductionAssetContract",
  "type": "object",
  "required": [
    "assetId",
    "assetType",
    "tier",
    "owner",
    "source",
    "license",
    "legalTicket",
    "lodCount",
    "hasCollision",
    "skeletonProfile",
    "localeCoverage",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "assetId": { "type": "string", "minLength": 3 },
    "assetType": {
      "type": "string",
      "enum": ["character", "environment", "prop", "vfx", "audio", "ui"]
    },
    "tier": { "type": "string", "enum": ["hero", "mid", "background"] },
    "owner": { "type": "string", "minLength": 2 },
    "source": {
      "type": "string",
      "enum": ["internal", "outsource", "marketplace"]
    },
    "license": { "type": "string", "minLength": 2 },
    "legalTicket": { "type": "string", "minLength": 3 },
    "lodCount": { "type": "integer", "minimum": 0 },
    "hasCollision": { "type": "boolean" },
    "skeletonProfile": { "type": ["string", "null"] },
    "localeCoverage": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 }
    },
    "status": {
      "type": "string",
      "enum": ["blockout", "review", "approved", "integrated", "deprecated"]
    },
    "graphics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "triangleCount",
        "materialCount",
        "maxTextureSize",
        "textureSetCount",
        "modelFormat",
        "modelPath",
        "lodFiles"
      ],
      "properties": {
        "triangleCount": { "type": "integer", "minimum": 0 },
        "materialCount": { "type": "integer", "minimum": 0 },
        "maxTextureSize": { "type": "integer", "minimum": 0 },
        "textureSetCount": { "type": "integer", "minimum": 0 },
        "modelFormat": { "type": "string", "enum": ["glb", "gltf", "none"] },
        "modelPath": { "type": ["string", "null"] },
        "lodFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
