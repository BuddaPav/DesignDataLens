# API Keys - Copy to .env.local and fill in values
# DO NOT commit actual secrets!

# ==================== LLM Providers ====================
# Ollama (local)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace Inference API
HF_TOKEN=hf_your_token_here

# NVIDIA NIM
NVIDIA_API_KEY=

# OpenAI (GPT-4, etc)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Yandex Cloud
YANDEX_API_KEY=

# Groq (fast inference)
USE_GROQ=0
GROQ_API_KEY=

# OpenRouter (aggregate)
USE_OPENROUTER=0
OPENROUTER_API_KEY=

# ==================== Telegram Bot ====================
TELEGRAM_BOT_TOKEN=

# ==================== App Features ====================
CHRONOS_DESKTOP_DEV=0

# Meshy AI (3D model generation)
MESHY_API_KEY=

# Kenney Assets
KENNEY_ASSET_URLS=

# ==================== CI/CD ====================
CI=